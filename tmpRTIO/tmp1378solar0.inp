rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1378atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1378wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1378ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1378aero1D.dat
aerosol_angstrom 1.100000 0.014868
aerosol_set_tau_at_wvl 355 0.01486842422044862
brdf_cam u10 3.729926347732544
albedo_file ./tmpRTIO/tmp1378albedosolar.dat
sza 67.38478088378906
phi0 58.75498962402344
