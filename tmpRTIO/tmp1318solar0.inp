rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1318atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1318wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1318ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1318aero1D.dat
aerosol_angstrom 1.100000 0.108643
aerosol_set_tau_at_wvl 355 0.10864319781584494
brdf_cam u10 5.014853477478027
albedo_file ./tmpRTIO/tmp1318albedosolar.dat
sza 67.85797119140625
phi0 59.59526062011719
