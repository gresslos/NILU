rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param fu
source thermal
wavelength 4500 100000
mc_backward 
mc_backward_output eup
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1317atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1317wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1317ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1317aero1D.dat
aerosol_set_tau_at_wvl 4500 0.04732154737229472
brdf_cam u10 5.014853477478027
albedo_file ./tmpRTIO/tmp1317albedothermal.dat
sza 67.8664321899414
phi0 59.61091613769531
