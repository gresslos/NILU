rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1285atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1285wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1285ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1285aero1D.dat
aerosol_angstrom 1.100000 0.018805
aerosol_set_tau_at_wvl 355 0.01880543001904521
brdf_cam u10 5.423378944396973
albedo_file ./tmpRTIO/tmp1285albedosolar.dat
sza 68.12054443359375
phi0 60.09236145019531
