rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1294atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1294wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1294ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1294aero1D.dat
aerosol_angstrom 1.100000 0.013745
aerosol_set_tau_at_wvl 355 0.013745429450651376
brdf_cam u10 5.565880298614502
albedo_file ./tmpRTIO/tmp1294albedosolar.dat
sza 68.052734375
phi0 59.96177673339844
