rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1304atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1304wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1304ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1304aero1D.dat
aerosol_angstrom 1.100000 0.004623
aerosol_set_tau_at_wvl 355 0.004623472097503703
brdf_cam u10 5.308115005493164
albedo_file ./tmpRTIO/tmp1304albedosolar.dat
sza 67.968017578125
phi0 59.80078125
