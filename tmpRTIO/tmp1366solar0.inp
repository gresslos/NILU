rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1366atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1366wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1366ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1366aero1D.dat
aerosol_angstrom 1.100000 0.012931
aerosol_set_tau_at_wvl 355 0.012931085366213868
brdf_cam u10 3.7970638275146484
albedo_file ./tmpRTIO/tmp1366albedosolar.dat
sza 67.48611450195312
phi0 58.92942810058594
