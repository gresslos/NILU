rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param fu
source thermal
wavelength 4500 100000
mc_backward 
mc_backward_output eup
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1365atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1365wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1365ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1365aero1D.dat
aerosol_set_tau_at_wvl 4500 0.03767508899087275
brdf_cam u10 3.7970638275146484
albedo_file ./tmpRTIO/tmp1365albedothermal.dat
sza 67.48611450195312
phi0 58.92942810058594
