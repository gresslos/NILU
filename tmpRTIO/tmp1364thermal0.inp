rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param fu
source thermal
wavelength 4500 100000
mc_backward 
mc_backward_output eup
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1364atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1364wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1364ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1364aero1D.dat
aerosol_set_tau_at_wvl 4500 0.026811895982347643
brdf_cam u10 3.7970638275146484
albedo_file ./tmpRTIO/tmp1364albedothermal.dat
sza 67.49456024169922
phi0 58.94410705566406
