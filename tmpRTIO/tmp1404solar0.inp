rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1404atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1404wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1404ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1404aero1D.dat
aerosol_angstrom 1.100000 0.344835
aerosol_set_tau_at_wvl 355 0.34483485550429843
brdf_cam u10 3.096987247467041
albedo_file ./tmpRTIO/tmp1404albedosolar.dat
sza 67.18212890625
phi0 58.41438293457031
