rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param fu
source thermal
wavelength 4500 100000
mc_backward 
mc_backward_output eup
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1289atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1289wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1289ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1289aero1D.dat
aerosol_set_tau_at_wvl 4500 0.009195924241187366
brdf_cam u10 5.63639497756958
albedo_file ./tmpRTIO/tmp1289albedothermal.dat
sza 68.08663177490234
phi0 60.02687072753906
