rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1386atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1386wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1386ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1386aero1D.dat
aerosol_angstrom 1.100000 0.003671
aerosol_set_tau_at_wvl 355 0.0036714790004547648
brdf_cam u10 3.548372507095337
albedo_file ./tmpRTIO/tmp1386albedosolar.dat
sza 67.32567596435547
phi0 58.654541015625
