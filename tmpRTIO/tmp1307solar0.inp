rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1307atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1307wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1307ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1307aero1D.dat
aerosol_angstrom 1.100000 0.038084
aerosol_set_tau_at_wvl 355 0.038084277673914695
brdf_cam u10 5.308115005493164
albedo_file ./tmpRTIO/tmp1307albedosolar.dat
sza 67.94261169433594
phi0 59.75297546386719
