rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1319atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1319wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1319ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1319aero1D.dat
aerosol_angstrom 1.100000 0.101307
aerosol_set_tau_at_wvl 355 0.10130700627710894
brdf_cam u10 5.014853477478027
albedo_file ./tmpRTIO/tmp1319albedosolar.dat
sza 67.8495101928711
phi0 59.579620361328125
