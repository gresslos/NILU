rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param fu
source thermal
wavelength 4500 100000
mc_backward 
mc_backward_output eup
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1284atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1284wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1284ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1284aero1D.dat
aerosol_set_tau_at_wvl 4500 0.011503699039357084
brdf_cam u10 5.423378944396973
albedo_file ./tmpRTIO/tmp1284albedothermal.dat
sza 68.12902069091797
phi0 60.108795166015625
