rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1302atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1302wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1302ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1302aero1D.dat
aerosol_angstrom 1.100000 0.040592
aerosol_set_tau_at_wvl 355 0.040591671037885704
brdf_cam u10 5.5375518798828125
albedo_file ./tmpRTIO/tmp1302albedosolar.dat
sza 67.98495483398438
phi0 59.83277893066406
