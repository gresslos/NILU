rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1293atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1293wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1293ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1293aero1D.dat
aerosol_angstrom 1.100000 0.015645
aerosol_set_tau_at_wvl 355 0.015645162309921808
brdf_cam u10 5.63639497756958
albedo_file ./tmpRTIO/tmp1293albedosolar.dat
sza 68.06120300292969
phi0 59.97801208496094
