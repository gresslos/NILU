rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1409atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1409wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1409ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1409aero1D.dat
aerosol_angstrom 1.100000 0.066813
aerosol_set_tau_at_wvl 355 0.06681261665794766
brdf_cam u10 2.9146475791931152
albedo_file ./tmpRTIO/tmp1409albedosolar.dat
sza 67.13990783691406
phi0 58.344757080078125
