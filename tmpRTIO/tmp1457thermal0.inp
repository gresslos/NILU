rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param fu
source thermal
wavelength 4500 100000
mc_backward 
mc_backward_output eup
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1457atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1457wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1457ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1457aero1D.dat
aerosol_set_tau_at_wvl 4500 0.04848104248808955
brdf_cam u10 3.6356961727142334
albedo_file ./tmpRTIO/tmp1457albedothermal.dat
sza 66.76826477050781
phi0 57.750701904296875
