rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1354atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1354wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1354ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1354aero1D.dat
aerosol_angstrom 1.100000 0.021646
aerosol_set_tau_at_wvl 355 0.021646137423530925
brdf_cam u10 4.029561519622803
albedo_file ./tmpRTIO/tmp1354albedosolar.dat
sza 67.57901763916016
phi0 59.091888427734375
