rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1458atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1458wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1458ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1458aero1D.dat
aerosol_angstrom 1.100000 0.028081
aerosol_set_tau_at_wvl 355 0.028081103956514995
brdf_cam u10 3.504915714263916
albedo_file ./tmpRTIO/tmp1458albedosolar.dat
sza 66.75981140136719
phi0 57.73759460449219
