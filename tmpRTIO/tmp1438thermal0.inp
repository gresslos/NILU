rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param fu
source thermal
wavelength 4500 100000
mc_backward 
mc_backward_output eup
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1438atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1438wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1438ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1438aero1D.dat
aerosol_set_tau_at_wvl 4500 0.07282427055146536
brdf_cam u10 3.440561294555664
albedo_file ./tmpRTIO/tmp1438albedothermal.dat
sza 66.91187286376953
phi0 57.97630310058594
