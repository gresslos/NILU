rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1431atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1431wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1431ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1431aero1D.dat
aerosol_angstrom 1.100000 0.176312
aerosol_set_tau_at_wvl 355 0.1763118524800441
brdf_cam u10 3.261514902114868
albedo_file ./tmpRTIO/tmp1431albedosolar.dat
sza 66.97100067138672
phi0 58.07063293457031
