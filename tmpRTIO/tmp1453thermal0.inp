rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param fu
source thermal
wavelength 4500 100000
mc_backward 
mc_backward_output eup
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1453atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1453wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1453ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1453aero1D.dat
aerosol_set_tau_at_wvl 4500 0.04928525392277078
brdf_cam u10 3.6356961727142334
albedo_file ./tmpRTIO/tmp1453albedothermal.dat
sza 66.7936019897461
phi0 57.7901611328125
