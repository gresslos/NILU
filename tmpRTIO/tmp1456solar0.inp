rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1456atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1456wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1456ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1456aero1D.dat
aerosol_angstrom 1.100000 0.001293
aerosol_set_tau_at_wvl 355 0.0012933498018707981
brdf_cam u10 3.6356961727142334
albedo_file ./tmpRTIO/tmp1456albedosolar.dat
sza 66.7767105102539
phi0 57.76383972167969
