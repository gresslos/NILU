rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1375atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1375wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1375ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1375aero1D.dat
aerosol_angstrom 1.100000 0.016095
aerosol_set_tau_at_wvl 355 0.016094524584013864
brdf_cam u10 3.594088315963745
albedo_file ./tmpRTIO/tmp1375albedosolar.dat
sza 67.41011047363281
phi0 58.79833984375
