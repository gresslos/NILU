rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1371atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1371wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1371ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1371aero1D.dat
aerosol_angstrom 1.100000 0.021692
aerosol_set_tau_at_wvl 355 0.021692181619085628
brdf_cam u10 3.7970638275146484
albedo_file ./tmpRTIO/tmp1371albedosolar.dat
sza 67.44389343261719
phi0 58.85639953613281
