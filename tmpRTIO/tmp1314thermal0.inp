rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param fu
source thermal
wavelength 4500 100000
mc_backward 
mc_backward_output eup
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1314atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1314wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1314ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1314aero1D.dat
aerosol_set_tau_at_wvl 4500 0.022790940597051855
brdf_cam u10 5.014853477478027
albedo_file ./tmpRTIO/tmp1314albedothermal.dat
sza 67.89181518554688
phi0 59.658050537109375
