rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param fu
source thermal
wavelength 4500 100000
mc_backward 
mc_backward_output eup
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1429atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1429wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1429ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1429aero1D.dat
aerosol_set_tau_at_wvl 4500 0.07554312786845657
brdf_cam u10 2.9638803005218506
albedo_file ./tmpRTIO/tmp1429albedothermal.dat
sza 66.9878921508789
phi0 58.09773254394531
