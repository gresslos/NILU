rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param fu
source thermal
wavelength 4500 100000
mc_backward 
mc_backward_output eup
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1448atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1448wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1448ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1448aero1D.dat
aerosol_set_tau_at_wvl 4500 0.08894950735615287
brdf_cam u10 3.6046664714813232
albedo_file ./tmpRTIO/tmp1448albedothermal.dat
sza 66.83584594726562
phi0 57.85626220703125
