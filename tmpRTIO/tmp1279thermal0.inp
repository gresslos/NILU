rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param fu
source thermal
wavelength 4500 100000
mc_backward 
mc_backward_output eup
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1279atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1279wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1279ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1279aero1D.dat
aerosol_set_tau_at_wvl 4500 0.014759722472493507
brdf_cam u10 5.423378944396973
albedo_file ./tmpRTIO/tmp1279albedothermal.dat
sza 68.17141723632812
phi0 60.19132995605469
