rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1287atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1287wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1287ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1287aero1D.dat
aerosol_angstrom 1.100000 0.017011
aerosol_set_tau_at_wvl 355 0.017011380721679736
brdf_cam u10 5.63639497756958
albedo_file ./tmpRTIO/tmp1287albedosolar.dat
sza 68.10359191894531
phi0 60.0595703125
