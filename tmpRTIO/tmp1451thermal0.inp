rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param fu
source thermal
wavelength 4500 100000
mc_backward 
mc_backward_output eup
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1451atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1451wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1451ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1451aero1D.dat
aerosol_set_tau_at_wvl 4500 0.09134890018456349
brdf_cam u10 3.6356961727142334
albedo_file ./tmpRTIO/tmp1451albedothermal.dat
sza 66.81050109863281
phi0 57.81654357910156
