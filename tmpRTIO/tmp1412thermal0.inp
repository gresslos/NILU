rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param fu
source thermal
wavelength 4500 100000
mc_backward 
mc_backward_output eup
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1412atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1412wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1412ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1412aero1D.dat
aerosol_set_tau_at_wvl 4500 0.14896441790077763
brdf_cam u10 2.9146475791931152
albedo_file ./tmpRTIO/tmp1412albedothermal.dat
sza 67.12301635742188
phi0 58.31703186035156
