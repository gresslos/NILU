rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1316atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1316wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1316ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1316aero1D.dat
aerosol_angstrom 1.100000 0.039907
aerosol_set_tau_at_wvl 355 0.039906957900129124
brdf_cam u10 5.014853477478027
albedo_file ./tmpRTIO/tmp1316albedosolar.dat
sza 67.87489318847656
phi0 59.62660217285156
