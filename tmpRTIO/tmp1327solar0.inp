rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1327atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1327wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1327ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1327aero1D.dat
aerosol_angstrom 1.100000 0.115983
aerosol_set_tau_at_wvl 355 0.11598305295277886
brdf_cam u10 4.698546409606934
albedo_file ./tmpRTIO/tmp1327albedosolar.dat
sza 67.79029846191406
phi0 59.47087097167969
