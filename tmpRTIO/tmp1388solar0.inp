rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 226
atmosphere_file ./tmpRTIO/tmp1388atm.dat
wc_properties mie
wc_file 1D ./tmpRTIO/tmp1388wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIO/tmp1388ic1D.dat
aerosol_default 
aerosol_file tau ./tmpRTIO/tmp1388aero1D.dat
aerosol_angstrom 1.100000 0.014061
aerosol_set_tau_at_wvl 355 0.014061263272880601
brdf_cam u10 3.548372507095337
albedo_file ./tmpRTIO/tmp1388albedosolar.dat
sza 67.30879211425781
phi0 58.626007080078125
