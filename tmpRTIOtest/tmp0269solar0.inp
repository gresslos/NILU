rte_solver disort
data_files_path /xnilu_wrk2/projects/NEVAR/libRadtran/data/
mol_abs_param kato2
source solar
wavelength 300 4000
output_process sum
zout atm_levels
output_user sza zout edir eup
quiet 
day_of_year 290
atmosphere_file ./tmpRTIOtest/tmp0269atm.dat
wc_properties mie
wc_file 1D ./tmpRTIOtest/tmp0269wc1D.dat
ic_properties baum_v36 interpolate
ic_habit ghm
ic_file 1D ./tmpRTIOtest/tmp0269ic1D.dat
brdf_cam u10 9.399083137512207
albedo_file ./tmpRTIOtest/tmp0269albedosolar.dat
sza 83.4393539428711
phi0 48.22637939453125
